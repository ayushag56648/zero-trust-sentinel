MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=zero_trust_sentinel

# Optional: use URL instead of separate fields
# MYSQL_URL=mysql://root:your_password@127.0.0.1:3306/zero_trust_sentinel
# DATABASE_URL=mysql://root:your_password@127.0.0.1:3306/zero_trust_sentinel

# Optional custom table/column names
MYSQL_GATEKEEPER_TABLE=user_gatekeeper
MYSQL_GATEKEEPER_USER_ID_COL=user_id
MYSQL_GATEKEEPER_SCAN_COUNT_COL=scan_count
